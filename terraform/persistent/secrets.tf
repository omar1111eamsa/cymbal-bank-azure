# --- Cymbal Bank app secrets: generated by Terraform, stored only in Key Vault ---
# "ephemeral" + "value_wo" (write-only): the values never touch Terraform state or plan files.
# The ephemeral values change on every run, but Key Vault only receives one when
# value_wo_version changes. To rotate a secret: bump its version.
# Names: Key Vault allows only letters, digits and "-" (no "/" like Secrets Manager).
# JSON values so ESO reads them with "property: password" (same as on AWS).

ephemeral "random_password" "accounts_db" {
  length  = 32
  special = false # used inside a postgresql:// URI
}

resource "azurerm_key_vault_secret" "accounts_db" {
  name             = "cymbal-bank-accounts-db"
  key_vault_id     = azurerm_key_vault.kv.id
  content_type     = "application/json"
  value_wo         = jsonencode({ password = ephemeral.random_password.accounts_db.result })
  value_wo_version = 1
}

ephemeral "random_password" "ledger_db" {
  length  = 32
  special = false # used inside a JDBC URL
}

resource "azurerm_key_vault_secret" "ledger_db" {
  name             = "cymbal-bank-ledger-db"
  key_vault_id     = azurerm_key_vault.kv.id
  content_type     = "application/json"
  value_wo         = jsonencode({ password = ephemeral.random_password.ledger_db.result })
  value_wo_version = 1
}

# RSA key pair that signs and verifies user login tokens (JWT)
ephemeral "tls_private_key" "jwt" {
  algorithm = "RSA"
  rsa_bits  = 4096
}

resource "azurerm_key_vault_secret" "jwt" {
  name         = "cymbal-bank-jwt-key"
  key_vault_id = azurerm_key_vault.kv.id
  content_type = "application/json"
  value_wo = jsonencode({
    private_key = ephemeral.tls_private_key.jwt.private_key_pem
    public_key  = ephemeral.tls_private_key.jwt.public_key_pem
  })
  value_wo_version = 1
}
